name: Strategy lab 16
on:
  workflow_dispatch:
  push:
    paths:
      - ".github/workflows/lab16.yml"
      - "backtest_lab16.py"
concurrency:
  group: lab16
  cancel-in-progress: true
permissions:
  contents: write
jobs:
  lab16:
    runs-on: ubuntu-latest
    timeout-minutes: 120
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: python backtest_lab16.py
        env:
          LAB7_TOTAL: "100"
          LAB6_MONTHS: "84"
          NTFY_TOPIC: ${{ secrets.NTFY_TOPIC }}
      - name: Save results
        run: |
          git config user.name "scanner-bot"
          git config user.email "scanner-bot@users.noreply.github.com"
          git add lab16_summary.txt 2>/dev/null || true
          git diff --cached --quiet || (git commit -m "Strategy lab 16 results" && (git pull --rebase -q; git push))
